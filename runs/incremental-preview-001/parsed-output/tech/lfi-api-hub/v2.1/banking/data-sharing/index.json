  "content": {
    "title": "Bank Data Sharing",
    "intro": [
      {
        "type": "paragraph",
        "text": "The Open Finance Banking Data Sharing capabilities enable secure, consent-driven access to customer banking data. These services empower licensed third-party providers (TPPs) to deliver account aggregation, financial management tools, lending assessments, and value-added digital services."
      }
    ],
    "sections": [
      {
        "heading": "Bank Data Sharing Provider",
        "level": 2,
        "anchor": null,
        "blocks": [
          {
            "type": "paragraph",
            "text": "Access to the Bank Data Sharing APIs requires TPPs to hold the BDSP role. The API Hub validates the role on every request before proxying it to the LFI."
          }
        ],
        "subsections": []
      },
      {
        "heading": "Endpoint & account type coverage",
        "level": 2,
        "anchor": null,
        "blocks": [
          {
            "type": "paragraph",
            "text": "Not all endpoints are expected to be delivered for every account subtype, and not all account subtypes are available for every account type."
          }
        ],
