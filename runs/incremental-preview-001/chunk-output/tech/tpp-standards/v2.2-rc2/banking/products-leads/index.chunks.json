    {
      "id": "867fd41e-29c4-5e95-bdfd-9c6fca098da2",
      "document_id": "tech/tpp-standards/v2.2-rc2/banking/products-leads",
      "type": "intro",
      "text": "Products & Leads\n\nThe Products & Leads API lets a TPP fetch the banking product catalogues published by LFIs and forward customer leads back to them. Products are aggregated across LFIs and presented to the user; leads are submitted on demand when the user requests follow-up.",
      "metadata": {
        "title": "Products & Leads",
        "source_repo": "Nebras-Open-Finance/community-standards",
        "source_file": "src/pages/tech/tpp-standards/v2.2-rc2/banking/products-leads/index.vue",
