  "content": {
    "title": "Confirmation of Payee — API Guide",
    "intro": [
      {
        "type": "paragraph",
        "text": "Confirmation of Payee (CoP) lets a TPP verify that an IBAN belongs to the named individual or business before initiating a payment."
      }
    ],
    "sections": [
      {
        "heading": "End-to-end Confirmation of Payee",
        "level": 2,
        "anchor": "sequence-flow",
        "category": "API Sequence Flow",
        "blocks": [],
        "subsections": []
      },
      {
        "heading": "Match an IBAN against an account holder",
        "level": 2,
        "anchor": "post-cop-query",
        "category": "POST /customers/action/cop-query",
        "blocks": [],
        "subsections": [
          {
            "heading": "Request headers",
            "level": 3,
            "anchor": null,
            "blocks": [
              {
                "type": "table",
                "headers": [
                  "Header",
                  "Required",
                  "Description"
                ],
                "rows": [
                  [
                    "o3-provider-id",
                    "Yes",
                    "Identifier for your LFI registered in the Hub"
                  ],
                  [
                    "o3-aspsp-id",
                    "Yes (deprecated)",
                    "Deprecated alias for o3-provider-id. Will be removed in a future version — use o3-provider-id"
                  ],
                  [
                    "o3-caller-org-id",
                    "Yes",
                    "Organisation ID of the TPP making the underlying request"
                  ],
                  [
                    "o3-caller-client-id",
                    "Yes",
                    "OIDC client ID of the TPP application"
                  ],
                  [
                    "o3-caller-software-statement-id",
                    "Yes",
                    "Software statement ID of the TPP application"
                  ],
                  [
                    "o3-api-uri",
                    "Yes",
                    "The parameterised URL of the API being called by the TPP"
                  ],
                  [
                    "o3-api-operation",
                    "Yes",
                    "The HTTP method of the operation carried out by the TPP (e.g. POST )"
                  ],
                  [
                    "o3-ozone-interaction-id",
                    "Yes",
                    "Hub-generated interaction ID. Equals o3-caller-interaction-id if the TPP provided one"
                  ],
                  [
                    "o3-caller-interaction-id",
                    "No",
                    "Interaction ID passed in by the TPP, if present"
                  ]
                ]
              }
            ]
          },
          {
            "heading": "Query parameters",
            "level": 3,
            "anchor": null,
            "blocks": [
              {
                "type": "table",
                "headers": [
                  "Parameter",
                  "Required",
                  "Default",
                  "Description"
                ],
                "rows": [
                  [
                    "page",
                    "Yes",
                    "1",
                    "Page number for paginated results"
                  ],
                  [
                    "page-size",
                    "Yes",
                    "100",
                    "Number of records per page"
                  ]
                ]
              }
            ]
          },
          {
            "heading": "Request body",
            "level": 3,
            "anchor": null,
            "blocks": [
              {
                "type": "paragraph",
                "text": "Content-Type: application/json"
              },
              {
                "type": "paragraph",
                "text": "The Hub sends a plain JSON body — not a JWS. The body always contains a single account identified by IBAN and a name to match against."
              }
            ]
          },
          {
            "heading": "data.account",
            "level": 4,
            "anchor": null,
            "blocks": [
              {
                "type": "table",
                "headers": [
                  "Field",
                  "Type",
                  "Required",
                  "Description"
                ],
                "rows": [
                  [
                    "schemeName",
                    "string",
                    "Yes",
                    "Always IBAN"
                  ],
                  [
                    "identification",
                    "string",
                    "Yes",
                    "The IBAN to look up"
                  ],
                  [
                    "name",
                    "object",
                    "Yes",
                    "Either a PersonName or BusinessName — see below"
                  ]
                ]
              }
            ]
          },
          {
            "heading": "PersonName",
            "level": 4,
            "anchor": null,
            "blocks": [
              {
                "type": "table",
                "headers": [
                  "Field",
                  "Type",
                  "Required",
                  "Description"
                ],
                "rows": [
                  [
                    "fullName",
                    "string",
                    "Yes",
                    "The full name of the person as submitted by the TPP"
                  ],
                  [
                    "firstName",
                    "string",
                    "No",
                    "Given name, if provided by the TPP"
                  ],
                  [
                    "lastName",
                    "string",
                    "No",
                    "Family name, if provided by the TPP"
                  ]
                ]
              }
            ]
          },
          {
            "heading": "BusinessName",
            "level": 4,
            "anchor": null,
            "blocks": [
              {
                "type": "table",
                "headers": [
                  "Field",
                  "Type",
                  "Required",
                  "Description"
                ],
                "rows": [
                  [
                    "businessName",
                    "string",
                    "Yes",
                    "The business name as submitted by the TPP"
                  ]
                ]
              }
            ]
          },
          {
            "heading": "Example — personal name",
            "level": 4,
            "anchor": null,
            "blocks": []
          },
          {
            "heading": "Example — business name",
            "level": 4,
            "anchor": null,
            "blocks": []
          },
          {
            "heading": "Response",
            "level": 3,
            "anchor": null,
            "blocks": [
              {
                "type": "paragraph",
                "text": "Content-Type: application/json"
              },
              {
                "type": "paragraph",
                "text": "Return 200 in all lookup scenarios — whether the account is found or not. The Hub interprets the data array contents to determine the match result returned to the TPP."
              }
            ]
          },
          {
            "heading": "200 — Account found",
            "level": 4,
            "anchor": null,
            "blocks": [
              {
                "type": "paragraph",
                "text": "Return a data array containing one record per account holder. Joint accounts may return multiple records."
              },
              {
                "type": "paragraph",
                "text": "verifiedClaims[].claims.fullName is mandatory. Include givenName and familyName if your system holds them separately — the Hub uses these to improve match precision."
              },
              {
                "type": "paragraph",
                "text": "Populate verifiedClaims[].organisationClaims.name with the registered business name on the account."
              }
            ]
          },
          {
            "heading": "200 — Account not found, opted out",
            "level": 4,
            "anchor": null,
            "blocks": [
              {
                "type": "paragraph",
                "text": "Return 200 with an empty data array for scenarios where no account was found matching the IBAN or if the account opted out of CoP. Do not use 404 or 204 — the Hub expects 200 and treats an empty array as a no-result response."
              }
            ]
          },
          {
            "heading": "Error responses",
            "level": 4,
            "anchor": null,
            "blocks": [
              {
                "type": "paragraph",
                "text": "All error bodies must include errorCode and errorMessage."
              },
              {
                "type": "table",
                "headers": [
                  "errorCode",
                  "errorMessage",
                  "When to use"
                ],
                "rows": [
                  [
                    "Consent.AccountTemporarilyBlocked",
                    "The account is blocked from receiving payments.",
                    "The account is blocked from receiving payments for a temporary reason — e.g. account status is Suspended"
                  ],
                  [
                    "Consent.PermanentAccountAccessFailure",
                    "The account is blocked from receiving payments.",
                    "The account is blocked from receiving payments permanently — e.g. account status is Closed, Deceased, or Unclaimed"
                  ]
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
