  "content": {
    "title": "Trust Framework — Contacts",
    "intro": [
      {
        "type": "paragraph",
        "text": "Organisation Contacts allow Organisations to register specific personnel contact information within the Trust Framework, ensuring that participants from other Organisations can easily reach the appropriate departments when needed."
      },
      {
        "type": "paragraph",
        "text": "The contact details registered here are visible to other participants outside your organisation."
      }
    ],
    "sections": [
      {
        "heading": "Each contact must be assigned one of these categories",
        "level": 2,
        "anchor": "contact-types",
        "category": "Contact Types",
        "blocks": [
          {
            "type": "table",
            "headers": [
              "Type",
              "Purpose"
            ],
            "rows": [
              [
                "Security",
                "Security incidents, vulnerability disclosures, and certificate issues"
              ],
              [
                "Billing",
                "Commercial and billing enquiries"
              ],
              [
                "Incident",
                "Operational incidents and service disruptions"
              ],
              [
                "Technical",
                "Technical integration and API support"
              ],
              [
                "Business",
                "General business and partnership enquiries"
              ]
            ]
          },
          {
            "type": "paragraph",
            "text": "Each contact requires an email address and a phone number."
          }
        ],
        "subsections": []
      },
      {
        "heading": "Step-by-step in the Trust Framework portal",
        "level": 2,
        "anchor": "adding",
        "category": "Adding an Organisation Contact",
        "blocks": [
          {
            "type": "ordered_list",
            "items": [
              "Log in to the Trust Framework and navigate to your organisation.",
              "Navigate to the Contacts section of your organisation.",
              "Click + New Contact.",
              "Select the Contact Type and enter the email address and phone number of the contact.",
              "Save the contact."
            ]
          }
        ],
        "subsections": []
      }
    ]
