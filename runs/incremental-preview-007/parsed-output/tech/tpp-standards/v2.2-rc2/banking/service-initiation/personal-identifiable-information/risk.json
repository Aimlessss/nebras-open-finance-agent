        "level": 2,
        "anchor": "schema-overview",
        "category": "Schema Overview",
        "blocks": [
          {
            "type": "table",
            "headers": [
              "Property",
              "Description"
            ],
            "rows": [
              [
                "DebtorIndicators",
                "Signals about the user: authentication method, device, location, account history"
              ],
              [
                "TransactionIndicators",
                "Signals about the transaction itself: channel, customer presence, merchant context"
              ],
              [
                "CreditorIndicators",
                "Signals about the payee: account type, merchant details, COP verification"
              ],
              [
                "DestinationDeliveryAddress",
                "Postal delivery address for the goods or services, if applicable"
              ]
            ]
          }
        ],
