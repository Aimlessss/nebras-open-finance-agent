  "content": {
    "title": "Products & Leads",
    "intro": [
      {
        "type": "paragraph",
        "text": "The Products & Leads API allows LFIs to publish their banking product catalogue and to receive customer leads forwarded by TPPs. Customers browse products in the TPP application and either apply directly via a channel the LFI configures (redirect URI, phone, email, or written instructions), or request follow-up contact — in which case the API Hub forwards the lead and the LFI follows up within 30 days."
      }
    ],
    "sections": [
      {
        "heading": "Bank Data Sharing Provider",
        "level": 2,
        "anchor": null,
        "blocks": [
          {
            "type": "paragraph",
            "text": "Access to the Products & Leads API requires TPPs to hold the BDSP role. The API Hub validates the role on every request before proxying it to the LFI."
          }
        ],
        "subsections": []
      },
      {
        "heading": "Who's consuming Products & Leads",
        "level": 2,
        "anchor": null,
        "blocks": [
          {
            "type": "paragraph",
            "text": "TPPs currently calling the Products & Leads API across UAE Open Finance."
          },
          {
            "type": "paragraph",
            "text": "Live data is currently unavailable."
          },
          {
            "type": "paragraph",
            "text": "No TPPs are currently active for this capability."
          }
        ],
        "subsections": []
      },
      {
