    {
      "id": "330c1924-6c16-540f-b22b-3819bd229cd4",
      "document_id": "tech/tpp-standards/security/fapi",
      "type": "section",
      "text": "FAPI Security Profile > Cryptographic Requirements > Algorithms and key sizes mandated by the profile\n\nRequirement | Value\nSigning algorithm | PS256 (RSA-PSS with SHA-256)\nMinimum RSA key size | 2048 bits\nToken endpoint auth method | private_key_jwt\nRequest object signing | Required for /par\nEncryption | Optional (see Message Encryption )",
      "metadata": {
        "title": "FAPI Security Profile",
        "section": "Algorithms and key sizes mandated by the profile",
        "category": "Cryptographic Requirements",
        "anchor": "crypto",
