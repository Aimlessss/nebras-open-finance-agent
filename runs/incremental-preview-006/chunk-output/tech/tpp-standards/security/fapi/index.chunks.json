    {
      "id": "b8ecab5e-af6c-52a0-a9c3-4e5fe1cd984f",
      "document_id": "tech/tpp-standards/security/fapi",
      "type": "intro",
      "text": "FAPI Security Profile\n\nUAE Open Finance mandates the FAPI 2.0 Security Profile ( Financial-grade API ) as the security foundation for all API interactions. FAPI 2.0 is an extension of OAuth 2.0 and OpenID Connect designed specifically for high-value financial APIs, where the consequences of a security breach are significant.",
      "metadata": {
        "title": "FAPI Security Profile",
        "source_repo": "Nebras-Open-Finance/community-standards",
        "source_file": "src/pages/tech/tpp-standards/security/fapi/index.vue",
