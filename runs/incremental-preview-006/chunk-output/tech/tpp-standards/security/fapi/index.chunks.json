    {
      "id": "7106ef00-69ec-5314-9798-3c1bab1e646d",
      "document_id": "tech/tpp-standards/security/fapi",
      "type": "subsection",
      "text": "FAPI Security Profile > Key Security Mechanisms > The four pillars of FAPI 2.0 in UAE Open Finance > Pushed Authorization Requests (PAR)\n\nRather than passing authorization parameters directly in a browser redirect URL (where they're visible and potentially manipulable), consent parameters are first sent server-to-server to the /par endpoint. The Authorization Server returns a short-lived request_uri which is the only thing passed in the browser redirect.\n\nThis ensures authorization parameters are never exposed in browser history or server logs.",
      "metadata": {
        "title": "FAPI Security Profile",
        "section": "The four pillars of FAPI 2.0 in UAE Open Finance",
        "category": "Key Security Mechanisms",
        "subsection": "Pushed Authorization Requests (PAR)",
        "anchor": "mechanisms",
        "source_repo": "Nebras-Open-Finance/community-standards",
        "source_file": "src/pages/tech/tpp-standards/security/fapi/index.vue",
        "parser": "vue-sfc",
        "source_commit": "67e5ca444c9ee40e4624fe6ea88d382e62c0d50f",
        "source_hash": "94ea96d633375e41183133f6da7536bc803d9be92d10d14204aa82324e1c6077",
        "url": "https://nebras-open-finance.com/tech/tpp-standards/security/fapi",
