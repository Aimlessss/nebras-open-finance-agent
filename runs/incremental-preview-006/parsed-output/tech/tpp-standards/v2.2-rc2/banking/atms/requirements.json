  "content": {
    "title": "ATMs — Requirements",
    "intro": [
      {
        "type": "paragraph",
        "text": "The tables below list the validation rules that apply to the ATM API. The Validated by\n column indicates where each rule is enforced."
      },
      {
        "type": "paragraph",
        "text": "All requests require an active Trust Framework application\n with the BDSP\n role, a valid transport certificate\n presented on every request via mTLS, and an active signing key\n for JWT signing."
      }
    ],
    "sections": [
      {
        "heading": "List Atms",
        "anchor": "list-atms",
        "blocks": [
          {
            "type": "table",
            "headers": [
              "Field",
              "Rule",
              "Validated by"
            ],
            "rows": [
              [
                "Authorization",
                "Must contain a valid Bearer access token obtained via a client_credentials\n grant with the atm\n scope.",
                "API Hub"
              ],
              [
                "x-fapi-interaction-id",
                "Should be included. Should be a valid UUID (RFC 4122). An invalid value will not cause a failure but tracing will not be possible.",
                "N/A"
              ]
            ]
          }
        ],
        "subsections": []
      }
    ]
  }
