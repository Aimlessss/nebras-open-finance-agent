    "intro": [
      {
        "type": "paragraph",
        "text": "The ATM API allows LFIs to publish ATM location and service data to TPPs. It is a read-only, public-data API — no consent or user redirect is required."
      }
    ],
    "sections": [
      {
        "heading": "Bank Data Sharing Provider",
        "level": 2,
        "anchor": null,
        "blocks": [
          {
            "type": "paragraph",
            "text": "Access to the ATM API requires TPPs to hold the BDSP role. The API Hub validates the role on every request before proxying it to the LFI."
          }
        ],
        "subsections": []
      },
      {
        "heading": "Who's consuming ATM data",
        "level": 2,
        "anchor": null,
        "blocks": [
