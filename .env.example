# Match these to the query embedding configuration before switching collections.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Optional. Leave unset to match the current query provider, which omits taskType.
EMBEDDING_TASK_TYPE=
GEMINI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
# Choose a NEW collection for the baseline.
QDRANT_COLLECTION=nebras_public_docs_v2
